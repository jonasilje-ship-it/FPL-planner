# Lokal utvikling: SQLite-fil. Produksjon: Postgres-URL fra Supabase.
# Eksempel prod: postgresql+psycopg2://postgres:PASSORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///data/fpl.sqlite

# Ditt FPL-lag (finnes i URL-en når du er innlogget: /entry/XXXXXXX/)
FPL_ENTRY_ID=3486140

# Hvor mange sekunder mellom hvert API-kall i de tunge jobbene
FPL_THROTTLE_SECONDS=0.25
